{
  "name": "Platelet Pooling Process",
  "description": "Lifeblood platelet pooling simulation with multiple processing stages",
  "version": "1.0",
  "devices": [
    {
      "id": "collection",
      "type": "collection_station",
      "wait_start": 2.0,
      "wait_execution_min": 15.0,
      "wait_execution_max": 30.0,
      "wait_exit": 1.0,
      "fail_prob": 0.01,
      "outputs": ["quality_check_1"]
    },
    {
      "id": "quality_check_1",
      "type": "quality_checker",
      "wait_start": 0.5,
      "wait_execution_min": 3.0,
      "wait_execution_max": 5.0,
      "wait_exit": 0.5,
      "fail_prob": 0.05,
      "outputs": ["storage_temp"]
    },
    {
      "id": "storage_temp",
      "type": "temperature_controlled_storage",
      "wait_start": 1.0,
      "wait_execution_min": 60.0,
      "wait_execution_max": 120.0,
      "wait_exit": 1.0,
      "fail_prob": 0.02,
      "outputs": ["pooling"]
    },
    {
      "id": "pooling",
      "type": "platelet_pooler",
      "wait_start": 3.0,
      "wait_execution_min": 10.0,
      "wait_execution_max": 20.0,
      "wait_exit": 2.0,
      "fail_prob": 0.03,
      "outputs": ["quality_check_2", "labeling"]
    },
    {
      "id": "quality_check_2",
      "type": "quality_checker",
      "wait_start": 0.5,
      "wait_execution_min": 3.0,
      "wait_execution_max": 5.0,
      "wait_exit": 0.5,
      "fail_prob": 0.04,
      "outputs": ["packaging"]
    },
    {
      "id": "labeling",
      "type": "label_printer",
      "wait_start": 0.5,
      "wait_execution_min": 1.0,
      "wait_execution_max": 2.0,
      "wait_exit": 0.5,
      "fail_prob": 0.01,
      "outputs": ["packaging"]
    },
    {
      "id": "packaging",
      "type": "packager",
      "wait_start": 1.0,
      "wait_execution_min": 5.0,
      "wait_execution_max": 8.0,
      "wait_exit": 1.0,
      "fail_prob": 0.02,
      "outputs": ["final_storage"]
    },
    {
      "id": "final_storage",
      "type": "cold_storage",
      "wait_start": 0.5,
      "wait_execution_min": 1.0,
      "wait_execution_max": 2.0,
      "wait_exit": 0.5,
      "fail_prob": 0.01,
      "outputs": []
    }
  ]
}
